<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:ExportViewModel"
             x:Class="Lauter_Fichaje.Views.ExportPage"
             Title="Exportar fichajes"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filtros de fecha -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                StrokeThickness="0"
                Margin="16,16,16,8"
                Padding="16,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Rango de fechas"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Desde"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                        <DatePicker Date="{Binding DateFrom}"
                                    Format="dd/MM/yyyy"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hasta"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                        <DatePicker Date="{Binding DateTo}"
                                    Format="dd/MM/yyyy"/>
                    </VerticalStackLayout>
                </Grid>
                <Button Text="Ver fichajes"
                        Command="{Binding LoadPreviewCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                        CornerRadius="8"
                        HeightRequest="44"/>
            </VerticalStackLayout>
        </Border>

        <!-- Lista de preview -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                       FontSize="14"
                       Margin="0,32"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FichajeExportRow">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0"
                            Margin="0,0,0,6"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Empleado}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight}, Dark={StaticResource AppTextPrimaryDark}}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Tipo}"
                                   FontSize="13"
                                   FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Entrada">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#16A34A, Dark=#22C55E}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Salida">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Email}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FechaHora}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer: indicador + estado + botón exportar -->
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,24" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"/>
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   HorizontalTextAlignment="Center"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
            <Button Text="Exportar a Excel"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    IsVisible="{Binding HasRows}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppSuccessLight}, Dark={StaticResource AppSuccessDark}}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
