<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:MainViewModel"
             x:Class="Lauter_Fichaje.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header fijo -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
              Padding="20,16"
              ColumnDefinitions="*,Auto,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding UserName}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Label Text="{Binding RoleDisplay}"
                       TextColor="#CCFFFFFF"
                       FontSize="13"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Exportar"
                    Command="{Binding GoToExportCommand}"
                    IsVisible="{Binding IsManagerOrAdmin}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="White"
                    BorderWidth="1"
                    CornerRadius="6"
                    HeightRequest="36"
                    Margin="0,0,8,0"
                    Padding="12,0"/>
            <Button Grid.Column="2"
                    Text="Salir"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="White"
                    BorderWidth="1"
                    CornerRadius="6"
                    HeightRequest="36"
                    Padding="12,0"/>
        </Grid>

        <!-- Contenido scrollable via CollectionView -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Fichajes}"
                        Margin="0">

            <!-- Estado actual + botón de fichaje -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- Tarjeta de estado -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0"
                            Padding="20,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Estado actual"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                       FontSize="13"/>
                                <Label Text="{Binding StatusText}"
                                       FontSize="22"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDentro}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#16A34A, Dark=#22C55E}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDentro}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Ellipse Grid.Column="1"
                                     WidthRequest="18" HeightRequest="18"
                                     VerticalOptions="Center">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDentro}" Value="True">
                                        <Setter Property="Fill" Value="{AppThemeBinding Light=#16A34A, Dark=#22C55E}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDentro}" Value="False">
                                        <Setter Property="Fill" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}"/>
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- Botón de fichaje -->
                    <Button Text="{Binding ActionButtonText}"
                            Command="{Binding RegisterFichajeCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                            CornerRadius="10"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"/>

                    <!-- Título historial -->
                    <Label Text="Mis fichajes"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"
                           Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Cada fichaje -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Fichaje">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0"
                            Margin="16,0,16,8"
                            Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="12,*,Auto"
                              RowDefinitions="Auto,Auto">
                            <BoxView Grid.Column="0" Grid.RowSpan="2"
                                     CornerRadius="6"
                                     WidthRequest="8" HeightRequest="8"
                                     VerticalOptions="Center">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsEntrada}" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light=#16A34A, Dark=#22C55E}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsEntrada}" Value="False">
                                        <Setter Property="Color" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TypeDisplay}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalOptions="Center"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LocationDisplay}"
                                   IsVisible="{Binding HasLocation}"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                                   FontSize="11"/>
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding FormattedTime}"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Cargar más -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="16,4,16,24">
                    <Button Text="Cargar más"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding HasMore}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="44"/>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>
