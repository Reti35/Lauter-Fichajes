<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:ExportViewModel"
             x:Class="Lauter_Fichaje.Views.ExportPage"
             Title="Exportar fichajes"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Filtros de fecha ──────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                StrokeThickness="0"
                Margin="16,16,16,0"
                Padding="16,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">

                <!-- Cabecera de sección — estilo panel oscuro del web -->
                <Grid ColumnDefinitions="Auto,*">
                    <BoxView Grid.Column="0"
                             Color="{StaticResource Primary}"
                             WidthRequest="3"
                             HeightRequest="16"
                             CornerRadius="2"
                             VerticalOptions="Center"
                             Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="Rango de fechas"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"
                           VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Desde"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                        <DatePicker Date="{Binding DateFrom}"
                                    Format="dd/MM/yyyy"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hasta"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                        <DatePicker Date="{Binding DateTo}"
                                    Format="dd/MM/yyyy"/>
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Ver fichajes"
                        Command="{Binding LoadPreviewCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        Style="{StaticResource ButtonTeal}"
                        HeightRequest="44"/>
            </VerticalStackLayout>
        </Border>

        <!-- ── Panel separador — estilo tabla Laeconsulting ────────────── -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}"
                StrokeThickness="0">
            <VerticalStackLayout Spacing="0">

                <!-- Cabecera de sección oscura — como "Reporte de semana en curso" web -->
                <Border BackgroundColor="{StaticResource SectionHeaderBg}"
                        Padding="16,10"
                        StrokeThickness="0"
                        Margin="0,14,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 Color="{StaticResource Secondary}"
                                 WidthRequest="3"
                                 HeightRequest="14"
                                 CornerRadius="2"
                                 VerticalOptions="Center"
                                 Margin="0,0,10,0"/>
                        <Label Grid.Column="1"
                               Text="Registros encontrados"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Lista de preview — filas estilo tabla Bootstrap -->
                <CollectionView ItemsSource="{Binding Rows}"
                                Margin="16,0">
                    <CollectionView.EmptyView>
                        <Label Text="{Binding StatusMessage}"
                               IsVisible="{Binding HasStatusMessage}"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                               FontSize="14"
                               Margin="0,32"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FichajeExportRow">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                                    StrokeThickness="0"
                                    Margin="0,0,0,6"
                                    Padding="0,0,14,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="5,*,Auto"
                                      RowDefinitions="Auto,Auto">
                                    <!-- Barra lateral coloreada por tipo -->
                                    <BoxView Grid.Column="0"
                                             Grid.RowSpan="2"
                                             WidthRequest="5"
                                             VerticalOptions="Fill"
                                             CornerRadius="3">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Tipo}" Value="Entrada">
                                                <Setter Property="Color" Value="{StaticResource StatusPresent}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Tipo}" Value="Salida">
                                                <Setter Property="Color" Value="{StaticResource StatusAbsent}"/>
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Empleado}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           Margin="12,10,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight}, Dark={StaticResource AppTextPrimaryDark}}"
                                           VerticalOptions="End"/>
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Email}"
                                           FontSize="12"
                                           Margin="12,2,0,10"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                           VerticalOptions="Start"/>

                                    <VerticalStackLayout Grid.Row="0"
                                                         Grid.Column="2"
                                                         Grid.RowSpan="2"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Tipo}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Entrada">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusPresent}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Salida">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusAbsent}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding FechaHora}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- ── Footer: indicador + exportar ────────────────────────────── -->
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,24" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"/>
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   HorizontalTextAlignment="Center"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
            <Button Text="Exportar a Excel"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    IsVisible="{Binding HasRows}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppSuccessLight}, Dark={StaticResource AppSuccessDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
