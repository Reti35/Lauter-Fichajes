<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:ExportViewModel"
             x:Class="Lauter_Fichaje.Views.ExportPage"
             Title="Exportar fichajes"
             BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filtros de fecha -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Margin="16,16,16,8"
                Padding="16,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="Rango de fechas"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="#374151"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Desde" FontSize="12" TextColor="#6B7280"/>
                        <DatePicker Date="{Binding DateFrom}"
                                    Format="dd/MM/yyyy"
                                    TextColor="#111827"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hasta" FontSize="12" TextColor="#6B7280"/>
                        <DatePicker Date="{Binding DateTo}"
                                    Format="dd/MM/yyyy"
                                    TextColor="#111827"/>
                    </VerticalStackLayout>
                </Grid>
                <Button Text="Ver fichajes"
                        Command="{Binding LoadPreviewCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"/>
            </VerticalStackLayout>
        </Border>

        <!-- Lista de preview -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       HorizontalTextAlignment="Center"
                       TextColor="#9CA3AF"
                       FontSize="14"
                       Margin="0,32"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FichajeExportRow">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Margin="0,0,0,6"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Empleado}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#111827"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Tipo}"
                                   FontSize="13"
                                   FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Entrada">
                                        <Setter Property="TextColor" Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="Salida">
                                        <Setter Property="TextColor" Value="#DC2626"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Email}"
                                   FontSize="12"
                                   TextColor="#6B7280"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FechaHora}"
                                   FontSize="12"
                                   TextColor="#6B7280"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer: indicador + estado + botón exportar -->
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,24" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"/>
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   HorizontalTextAlignment="Center"
                   FontSize="13"
                   TextColor="#6B7280"/>
            <Button Text="Exportar a Excel"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    IsVisible="{Binding HasRows}"
                    BackgroundColor="#16A34A"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
