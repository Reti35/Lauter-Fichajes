<Project>
  <!--
    SETUP PARA NUEVOS DESARROLLADORES
    ══════════════════════════════════
    1. Copia este archivo como "Secrets.props" en la misma carpeta.
    2. Rellena los valores con tus credenciales de Supabase
       (Project Settings → API en el panel de Supabase).
    3. Nunca commitas Secrets.props — ya está en .gitignore.

    PARA CI/CD (sin fichero local)
    ══════════════════════════════
    Pasa los valores como propiedades MSBuild:
      dotnet build -p:SupabaseUrl="https://xxx.supabase.co" \
                   -p:SupabaseAnonKey="eyJ..."
    O como variables de entorno con prefijo MSBUILDPROPERTY_:
      MSBUILDPROPERTY_SupabaseUrl=https://...
      MSBUILDPROPERTY_SupabaseAnonKey=eyJ...
  -->
  <PropertyGroup>
    <SupabaseUrl>YOUR_PROJECT_URL_HERE</SupabaseUrl>
    <SupabaseAnonKey>YOUR_ANON_KEY_HERE</SupabaseAnonKey>
  </PropertyGroup>
</Project>
