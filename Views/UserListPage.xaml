<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:UserListViewModel"
             x:Class="Lauter_Fichaje.Views.UserListPage"
             Title="Gestión de usuarios"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Nuevo" Command="{Binding GoToCreateUserCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Buscador ─────────────────────────────────────────────── -->
        <SearchBar Grid.Row="0"
                   Placeholder="Buscar por nombre, email o DNI"
                   Text="{Binding SearchText}"
                   Margin="10,10,10,0"
                   BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                   TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight}, Dark={StaticResource AppTextPrimaryDark}}"/>

        <ActivityIndicator Grid.Row="1"
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"
                            Color="{StaticResource Primary}"
                            Margin="0,10"/>

        <!-- ── Listado ──────────────────────────────────────────────── -->
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}">
            <CollectionView x:Name="UsersCollectionView"
                             ItemsSource="{Binding Users}"
                             SelectionMode="Single"
                             SelectionChanged="OnUserSelected">

                <CollectionView.EmptyView>
                    <Label Text="No se encontraron usuarios"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                           FontSize="14"
                           Margin="16,40"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                                StrokeThickness="0"
                                Margin="10,4"
                                Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight}, Dark={StaticResource AppTextPrimaryDark}}"/>
                                    <Label Text="{Binding Email}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#14331C}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FDECEA, Dark=#3A1A17}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label FontSize="11" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="Activo"/>
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AppSuccessLight}, Dark={StaticResource AppSuccessDark}}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Text" Value="Inactivo"/>
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="22"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
