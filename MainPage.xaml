<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             xmlns:models="clr-namespace:Lauter_Fichaje.Models"
             x:DataType="vm:MainViewModel"
             x:Class="Lauter_Fichaje.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════════════════════════════════════════════════════
             HEADER FIJO — azul marino, iguala sidebar/topbar Laeconsulting
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource SidebarBg}"
              Padding="20,16"
              ColumnDefinitions="*,Auto">

            <!-- Logo / empresa -->
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding UserName}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Label Text="{Binding RoleDisplay}"
                       TextColor="#99FFFFFF"
                       FontSize="13"/>
            </VerticalStackLayout>

            <!-- Acciones header -->
            <Button Grid.Column="2"
                    Text="Salir"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource ButtonOutlineWhite}"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CONTENIDO SCROLLABLE — CollectionView con header rico
             ══════════════════════════════════════════════════════════════ -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding GroupedFichajes}"
                        IsGrouped="True">

            <CollectionView.Header>
                <VerticalStackLayout Padding="0" Spacing="0">

                    <!-- ─── Saludo / bienvenida ─────────────────────────── -->
                    <VerticalStackLayout Padding="16,16,16,12" Spacing="2">
                        <Label Text="PANEL DE FICHAJES"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="1.2"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"/>
                        <Label Text="{Binding UserName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    </VerticalStackLayout>

                    <!-- ─── Tarjeta estado actual (panel blanco, ancho completo) ── -->
                    <Border Margin="16,0,16,10"
                            Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="ESTADO ACTUAL"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"/>
                                <Label Text="{Binding StatusText}"
                                       FontSize="20"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDentro}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource StatusPresent}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDentro}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource StatusAbsent}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Badge circular de presencia -->
                            <Ellipse Grid.Column="1"
                                     WidthRequest="24" HeightRequest="24"
                                     VerticalOptions="Center">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDentro}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusPresent}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDentro}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource StatusAbsent}"/>
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- ─── TARJETA ACCIÓN PRINCIPAL — Fichar ─────────────
                         Azul (CardBlue) cuando toca fichar entrada,
                         Teal (Secondary) cuando toca fichar salida
                         ─────────────────────────────────────────────────── -->
                    <Border Margin="16,0,16,10"
                            Padding="20,18"
                            BackgroundColor="{StaticResource CardBlue}"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <!-- Color dinámico: teal cuando ya estás dentro -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDentro}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RegisterFichajeCommand}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="ACCIÓN RÁPIDA"
                                       TextColor="#AAFFFFFF"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"/>
                                <Label Text="{Binding ActionButtonText}"
                                       TextColor="White"
                                       FontSize="22"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <!-- Icono de flecha — reemplaza el ícono FontAwesome del web -->
                            <Label Grid.Column="1"
                                   Text="▶"
                                   FontSize="30"
                                   TextColor="#66FFFFFF"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- ─── ActivityIndicator ──────────────────────────── -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Margin="16,4"/>

                    <!-- ─── GRID DE CARDS SECUNDARIAS — iguala el grid 4×2 del web ─
                         Col 0: Filtrar (siempre)
                         Col 1: Exportar (admin/gestor) — vacío para empleados
                         ────────────────────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,*"
                          Margin="16,0,16,0"
                          ColumnSpacing="10">

                        <!-- Card: Filtrar registros -->
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#374151}"
                                StrokeThickness="1"
                                Padding="14,14">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFilterCommand}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Border BackgroundColor="{AppThemeBinding Light=#EBF5FB, Dark=#1E3A5F}"
                                        StrokeThickness="0"
                                        Padding="10"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                    <Label Text="⚙"
                                           FontSize="22"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalTextAlignment="Center"/>
                                </Border>
                                <Label Text="{Binding FilterToggleText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card: Exportar (solo admin/gestor) -->
                        <Border Grid.Column="1"
                                IsVisible="{Binding IsManagerOrAdmin}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#374151}"
                                StrokeThickness="1"
                                Padding="14,14">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToExportCommand}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Border BackgroundColor="{AppThemeBinding Light=#E8F8F5, Dark=#1A3D35}"
                                        StrokeThickness="0"
                                        Padding="10"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                    <Label Text="📤"
                                           FontSize="22"
                                           HorizontalTextAlignment="Center"/>
                                </Border>
                                <Label Text="Exportar"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ─── PANEL DE FILTROS (colapsable) ─────────────────── -->
                    <Border IsVisible="{Binding IsFilterVisible}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0"
                            Padding="16,14">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="Rango de fechas"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Desde"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                                    <DatePicker Date="{Binding DateFrom}" Format="dd/MM/yyyy"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Hasta"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                                    <DatePicker Date="{Binding DateTo}" Format="dd/MM/yyyy"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Filtro por empleado (solo admin/gestor) -->
                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding IsManagerOrAdmin}">
                                <Label Text="Empleado"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"/>
                                <Picker ItemsSource="{Binding Employees}"
                                        SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding DisplayName}"/>
                            </VerticalStackLayout>

                            <!-- Botones de acción del filtro -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="Aplicar"
                                        Command="{Binding ApplyFilterCommand}"
                                        IsEnabled="{Binding IsNotLoading}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        TextColor="White"
                                        CornerRadius="6"
                                        HeightRequest="42"/>
                                <Button Grid.Column="1"
                                        Text="Limpiar"
                                        Command="{Binding ClearFilterCommand}"
                                        IsEnabled="{Binding IsNotLoading}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                        BorderColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                        BorderWidth="1"
                                        CornerRadius="6"
                                        HeightRequest="42"
                                        Padding="16,0"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ─── PANEL SEPARADOR DE SECCIÓN ─────────────────────
                         Iguala el banner oscuro "Reporte de semana en curso"
                         del web — fondo SectionHeaderBg (#1C3558)
                         ────────────────────────────────────────────────── -->
                    <Border BackgroundColor="{StaticResource SectionHeaderBg}"
                            Margin="0,14,0,0"
                            Padding="16,11"
                            StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- Acento lateral teal — iguala el look de las cards azul/teal del web -->
                            <BoxView Grid.Column="0"
                                     Color="{StaticResource Secondary}"
                                     WidthRequest="3"
                                     HeightRequest="16"
                                     CornerRadius="2"
                                     VerticalOptions="Center"
                                     Margin="0,0,10,0"/>
                            <Label Grid.Column="1"
                                   Text="Mis fichajes"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.3"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ══════════════════════════════════════════════════════════
                 CABECERA DE GRUPO — semana / fecha agrupada
                 ══════════════════════════════════════════════════════════ -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:FichajeGroup">
                    <Label Text="{Binding Header}"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                           Margin="16,10,16,4"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- ══════════════════════════════════════════════════════════
                 FILA DE FICHAJE — estilo fila Bootstrap DataTable
                 Barra lateral de color (verde entrada / rojo salida)
                 ══════════════════════════════════════════════════════════ -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Fichaje">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBgLight}, Dark={StaticResource AppCardBgDark}}"
                            StrokeThickness="0"
                            Margin="16,0,16,6"
                            Padding="0,0,14,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>

                        <Grid ColumnDefinitions="5,*,Auto"
                              RowDefinitions="Auto,Auto">

                            <!-- Barra lateral — altura total de la tarjeta, verde/rojo -->
                            <BoxView Grid.Column="0"
                                     Grid.RowSpan="2"
                                     WidthRequest="5"
                                     VerticalOptions="Fill"
                                     CornerRadius="3">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsEntrada}" Value="True">
                                        <Setter Property="Color" Value="{StaticResource StatusPresent}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsEntrada}" Value="False">
                                        <Setter Property="Color" Value="{StaticResource StatusAbsent}"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>

                            <!-- Tipo: Entrada / Salida -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TypeDisplay}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   Margin="12,10,0,0"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight}, Dark={StaticResource AppTextPrimaryDark}}"
                                   VerticalOptions="End"/>

                            <!-- Localización opcional -->
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LocationDisplay}"
                                   IsVisible="{Binding HasLocation}"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                                   FontSize="11"
                                   Margin="12,2,0,10"
                                   VerticalOptions="Start"/>

                            <!-- Hora — columna derecha, como en la tabla web -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Grid.RowSpan="2"
                                   Text="{Binding FormattedTime}"
                                   TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ══════════════════════════════════════════════════════════
                 VISTA VACÍA
                 ══════════════════════════════════════════════════════════ -->
            <CollectionView.EmptyView>
                <Label Text="Sin fichajes en el rango seleccionado"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource AppTextFaintLight}, Dark={StaticResource AppTextFaintDark}}"
                       FontSize="14"
                       Margin="16,40"/>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="28"
                         Color="{AppThemeBinding Light={StaticResource AppPageBgLight}, Dark={StaticResource AppPageBgDark}}"/>
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>
