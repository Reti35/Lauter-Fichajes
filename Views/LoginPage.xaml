<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lauter_Fichaje.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="Lauter_Fichaje.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EBEBEB">

    <!-- Fondo gris neutro plano, sin gradiente ni imagen — replica exacta del login web -->
    <ScrollView>
        <Grid RowDefinitions="*,Auto,2*" MinimumHeightRequest="560">

            <!-- Formulario en el tercio superior (~33% desde el top, igual que la web) -->
            <VerticalStackLayout Grid.Row="1"
                                 HorizontalOptions="Center"
                                 WidthRequest="300"
                                 Spacing="0">

                <!-- Logo-watermark "Lauter": tipografía grande en gris fantasma, efecto marca de agua -->
                <Label Text="Lauter"
                       FontSize="62"
                       FontAttributes="Bold"
                       TextColor="#D0D0D0"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,2"/>

                <!-- Título principal -->
                <Label Text="Bienvenido"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#444444"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4"/>

                <!-- Subtítulo secundario -->
                <Label Text="Introduce tus datos de acceso"
                       FontSize="13"
                       TextColor="#888888"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,24"/>

                <!-- Campo Email — borde gris outlined, fondo blanco, sin íconos -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#CCCCCC"
                        StrokeThickness="1"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="3"/>
                    </Border.StrokeShape>
                    <Entry Placeholder="Email"
                           Keyboard="Email"
                           Text="{Binding Email}"
                           ReturnType="Next"
                           ClearButtonVisibility="WhileEditing"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#AAAAAA"
                           TextColor="#333333"
                           Margin="4,0"/>
                </Border>

                <!-- Campo Contraseña — mismo estilo outlined -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#CCCCCC"
                        StrokeThickness="1"
                        Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="3"/>
                    </Border.StrokeShape>
                    <Entry Placeholder="Contraseña"
                           IsPassword="True"
                           Text="{Binding Password}"
                           ReturnType="Go"
                           ReturnCommand="{Binding LoginCommand}"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#AAAAAA"
                           TextColor="#333333"
                           Margin="4,0"/>
                </Border>

                <!-- Mensaje de error -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#E74C3C"
                       FontSize="13"
                       IsVisible="{Binding HasError}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8"/>

                <!-- Spinner de carga -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#2EAE8F"
                                   HeightRequest="32"
                                   Margin="0,0,0,8"/>

                <!-- Botón principal — verde-teal #2EAE8F, mismo color que la web -->
                <Button Text="Acceder"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="#2EAE8F"
                        TextColor="#FFFFFF"
                        CornerRadius="3"
                        HeightRequest="44"
                        FontAttributes="Bold"
                        FontSize="14"
                        Margin="0,0,0,12"/>

                <!-- Copyright -->
                <Label Text="© Lauter"
                       FontSize="11"
                       TextColor="#999999"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,0"/>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
