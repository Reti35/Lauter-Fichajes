<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ── Brand colors — Laeconsulting palette ──────────────────────── -->
    <Color x:Key="Primary">#1A7FC1</Color>          <!-- Azul corporativo — botones, highlights -->
    <Color x:Key="PrimaryDark">#5BA9D9</Color>      <!-- Azul claro para modo oscuro -->
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#2EAE8F</Color>         <!-- Verde-teal — cards de acción, nav -->
    <Color x:Key="SecondaryDarkText">#1A8F76</Color>
    <Color x:Key="Tertiary">#1C2E4A</Color>          <!-- Azul marino oscuro — header / sidebar -->

    <!-- ── Tokens de nombre propio ───────────────────────────────────── -->
    <Color x:Key="SidebarBg">#1C2E4A</Color>         <!-- Header app, fondo login -->
    <Color x:Key="SectionHeaderBg">#1C3558</Color>   <!-- Panel separador de secciones -->
    <Color x:Key="CardBlue">#1A7FC1</Color>           <!-- Card dashboard — azul -->
    <Color x:Key="CardTeal">#2EAE8F</Color>           <!-- Card dashboard — verde-teal -->
    <Color x:Key="StatusPresent">#27AE60</Color>      <!-- Badge verde — empleado presente / entrada -->
    <Color x:Key="StatusAbsent">#E74C3C</Color>       <!-- Rojo — salida / ausencia -->
    <Color x:Key="StatusNeutral">#95A5A6</Color>      <!-- Gris — pendiente / sin datos -->

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="MidnightBlue">#1C2E4A</Color>      <!-- Azul marino (reutilizado) -->
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ── Semantic tokens — Light theme ─────────────────────────────── -->
    <Color x:Key="AppPageBgLight">#F4F4F4</Color>
    <Color x:Key="AppCardBgLight">#FFFFFF</Color>
    <Color x:Key="AppTextPrimaryLight">#333333</Color>
    <Color x:Key="AppTextSecondaryLight">#555555</Color>
    <Color x:Key="AppTextMutedLight">#666666</Color>
    <Color x:Key="AppTextFaintLight">#95A5A6</Color>
    <Color x:Key="AppSuccessLight">#27AE60</Color>
    <Color x:Key="AppDangerLight">#E74C3C</Color>

    <!-- ── Semantic tokens — Dark theme ──────────────────────────────── -->
    <Color x:Key="AppPageBgDark">#111827</Color>
    <Color x:Key="AppCardBgDark">#1F2937</Color>
    <Color x:Key="AppTextPrimaryDark">#F9FAFB</Color>
    <Color x:Key="AppTextSecondaryDark">#E5E7EB</Color>
    <Color x:Key="AppTextMutedDark">#9CA3AF</Color>
    <Color x:Key="AppTextFaintDark">#6B7280</Color>
    <Color x:Key="AppSuccessDark">#22C55E</Color>
    <Color x:Key="AppDangerDark">#F87171</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
